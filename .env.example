# TuneSphere Environment Variables
# Copy this file to .env and fill in the values

# YouTube Data API v3 Key
# Get yours at: https://console.cloud.google.com/apis/credentials
# Required for searching and playing YouTube tracks
YT_API_KEY=YOUR_YOUTUBE_DATA_API_KEY_HERE

# MongoDB Connection String (optional, local default)
# MONGO_URI=mongodb://localhost:27017/tunesphere

# Server Port (optional, default: 5000)
# PORT=5000


# Database Mode (optional): local | mongo | auto (default: auto)
# local = always use JSON file DB, mongo = require MongoDB, auto = try Mongo then fallback to JSON
# DB_MODE=auto
